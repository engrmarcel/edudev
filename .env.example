APP_NAME=EduDEV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edudev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# EduDEV
# ------------------------------------------------------------------
# Admins sign in at /{ADMIN_PATH}/login (separate from the user /login).
# In production use a non-obvious value, e.g. ADMIN_PATH=staff-7k2q
ADMIN_PATH=admin

# Brand defaults (admins can override most of these in Admin -> Branding)
BRAND_PRODUCT_NAME=EduDEV
BRAND_COMPANY_NAME="MacoDev Limited"
BRAND_SLOGAN="Learn Smarter. Achieve More."
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_WEBSITE_URL=
BRAND_LOGO_PATH=

# Times are stored in UTC and displayed in this timezone
EDUDEV_DISPLAY_TIMEZONE=Africa/Lagos
EDUDEV_CURRENCY=NGN

# Used by: php artisan edudev:export-schema
MYSQLDUMP_PATH=mysqldump

# Two-step login (authenticator app). Leave unset to use the default:
# OFF in local/testing, ON when APP_ENV=production.
# TWO_FACTOR_ENABLED=false
# Roles that MUST use it when enabled (comma-separated). Default: all staff.
# TWO_FACTOR_REQUIRED_ROLES=super_admin,platform_admin,content_manager,support_agent
